{
  "extends": "./tsconfig.json",
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "app/**/.server/**/*",
    "app/**/.client/**/*",
    "workers/**/*",
    "worker-configuration.d.ts",
    "types/**/*.d.ts"
  ],
  "compilerOptions": {
    "strict": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"],
      "@ethernauta/abi": ["../../packages/abi/src"],
      "@ethernauta/arbitrum": ["../../packages/arbitrum/src"],
      "@ethernauta/chain": ["../../packages/chain/src"],
      "@ethernauta/chain/*": [
        "../../packages/chain/src/chain/eip155/*"
      ],
      "@ethernauta/core": ["../../packages/core/src"],
      "@ethernauta/crypto": ["../../packages/crypto/src"],
      "@ethernauta/eip/*": ["../../packages/eip/src/*"],
      "@ethernauta/ens": ["../../packages/ens/src"],
      "@ethernauta/erc/*": ["../../packages/erc/src/*"],
      "@ethernauta/eth": ["../../packages/eth/src"],
      "@ethernauta/op": ["../../packages/op/src"],
      "@ethernauta/react": ["../../packages/react/src"],
      "@ethernauta/transport": [
        "../../packages/transport/src"
      ],
      "@ethernauta/utils": ["../../packages/utils/src"],
      "@ethernauta/wallet": ["../../packages/wallet/src"],
      "@ethernauta/zksync": ["../../packages/zksync/src"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
