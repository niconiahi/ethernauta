{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ethernauta/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pagefind --site build",
    "preview": "wrangler pages dev build --port 4173",
    "deploy": "npm run build && wrangler pages deploy build --project-name=ethernauta-docs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@fontsource/fira-mono": "^5.1.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.15.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tanstack/react-query": "^5.100.14",
    "@types/react": "^19.2.15",
    "ethers": "^6.16.0",
    "mdsvex": "^0.12.3",
    "pagefind": "^1.2.0",
    "react": "^19.2.6",
    "shiki": "^3.0.0",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.1",
    "typescript": "5.8.3",
    "valibot": "1.1.0",
    "viem": "^2.48.11",
    "vite": "^6.0.7",
    "wrangler": "^4.13.2"
  }
}
