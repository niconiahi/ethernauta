{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ethernauta/erc",
  "version": "0.0.47",
  "description": "ERC method bindings (20, 721, 1155, 4626, 5267, …) as importable subpaths for Ethernauta.",
  "keywords": [
    "ethereum",
    "erc",
    "erc-20",
    "erc-721",
    "erc-1155",
    "erc-4626",
    "token"
  ],
  "homepage": "https://ethernauta-docs.pages.dev/",
  "bugs": {
    "url": "https://github.com/niconiahi/ethernauta/issues"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/niconiahi/ethernauta"
  },
  "sideEffects": false,
  "exports": {
    "./*": {
      "import": "./dist/*/index.js",
      "types": "./dist/*/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "generate": "ethernauta registry --in src --out src/registry/registry.generated.ts && biome format --write src/registry/registry.generated.ts",
    "prebuild": "pnpm run generate",
    "build": "tsdown",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest",
    "test:integration": "echo no integration tests"
  },
  "peerDependencies": {
    "valibot": "^1.1.0"
  },
  "dependencies": {
    "@ethernauta/abi": "workspace:*",
    "@ethernauta/core": "workspace:*",
    "@ethernauta/eip": "workspace:*",
    "@ethernauta/ens": "workspace:*",
    "@ethernauta/eth": "workspace:*",
    "@ethernauta/transport": "workspace:*",
    "@ethernauta/utils": "workspace:*",
    "@noble/hashes": "1.8.0",
    "@noble/secp256k1": "2.3.0"
  },
  "devDependencies": {
    "@ethernauta/cli": "workspace:*",
    "tsdown": "^0.13.3"
  }
}
