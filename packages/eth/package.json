{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ethernauta/eth",
  "version": "0.0.47",
  "description": "eth_* JSON-RPC methods + EIP-1559 fee math + gas-limit buffering for Ethernauta.",
  "keywords": [
    "ethereum",
    "json-rpc",
    "eth",
    "eip-1559",
    "gas",
    "fees"
  ],
  "homepage": "https://ethernauta-docs.pages.dev/",
  "bugs": {
    "url": "https://github.com/niconiahi/ethernauta/issues"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/niconiahi/ethernauta"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest",
    "test:integration": "echo no integration tests",
    "test:cli": "bun src/compiler/cli.ts --abi src/erc/165/IERC165.abi.json --out src/erc/165"
  },
  "peerDependencies": {
    "valibot": "^1.1.0"
  },
  "dependencies": {
    "@ethernauta/abi": "workspace:*",
    "@ethernauta/chain": "workspace:*",
    "@ethernauta/core": "workspace:*",
    "@ethernauta/eip": "workspace:*",
    "@ethernauta/transport": "workspace:*",
    "@ethernauta/utils": "workspace:*"
  },
  "devDependencies": {
    "@ethernauta/testing": "workspace:*",
    "bun": "^1.2.20",
    "tsdown": "^0.13.3"
  }
}
