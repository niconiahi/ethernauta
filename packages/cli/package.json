{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ethernauta/cli",
  "version": "0.0.47",
  "description": "Code generator for Ethernauta — emits ABI method bindings from contract ABIs.",
  "keywords": [
    "ethereum",
    "codegen",
    "abi",
    "cli",
    "tooling"
  ],
  "homepage": "https://ethernauta-docs.pages.dev/",
  "bugs": {
    "url": "https://github.com/niconiahi/ethernauta/issues"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/niconiahi/ethernauta"
  },
  "sideEffects": false,
  "bin": {
    "ethernauta": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest",
    "test:integration": "echo no integration tests"
  },
  "peerDependencies": {
    "valibot": "^1.1.0"
  },
  "dependencies": {
    "@ethernauta/abi": "workspace:*",
    "@ethernauta/core": "workspace:*",
    "@ethernauta/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsdown": "^0.13.3"
  }
}
