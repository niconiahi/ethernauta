{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ethernauta/wallet",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "dev": "run-p \"build:*:watch\"",
    "build": "run-s build:manifest build:content build:extension build:zip && pnpm run format",
    "build:zip": "rm -f extension.zip && cd dist && zip -r ../extension.zip .",
    "build:manifest": "vite build --config vite.manifest.config.ts",
    "build:content": "vite build --config vite.content.config.ts",
    "build:extension": "vite build --config vite.extension.config.ts",
    "build:manifest:watch": "vite build --watch --mode development --config vite.manifest.config.ts",
    "build:content:watch": "vite build --watch --mode development --config vite.content.config.ts",
    "build:extension:watch": "vite build --watch --mode development --config vite.extension.config.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "zip": "rm -f extension.zip && cd dist && zip -r ../extension.zip .",
    "test:unit": "vitest",
    "test:integration": "echo no integration tests"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@noble/secp256k1": "2.3.0",
    "@preact/signals": "^2.2.1",
    "preact": "10.26.9",
    "valibot": "1.1.0",
    "@ethernauta/abi": "workspace:*",
    "@ethernauta/chain": "workspace:*",
    "@ethernauta/core": "workspace:*",
    "@ethernauta/crypto": "workspace:*",
    "@ethernauta/eip": "workspace:*",
    "@ethernauta/erc": "workspace:*",
    "@ethernauta/utils": "workspace:*"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.2",
    "@tailwindcss/vite": "^4.1.11",
    "@types/chrome": "^0.1.1",
    "fake-indexeddb": "6.0.1",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.1.11",
    "viem": "^2.33.2"
  }
}
