{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ethernauta/eip",
  "type": "module",
  "version": "0.0.47",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/niconiahi/ethernauta"
  },
  "sideEffects": false,
  "exports": {
    "./*": {
      "import": "./dist/*/index.js",
      "types": "./dist/*/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest",
    "test:integration": "echo no integration tests"
  },
  "dependencies": {
    "@ethernauta/abi": "workspace:*",
    "@ethernauta/core": "workspace:*",
    "@ethernauta/transport": "workspace:*",
    "@ethernauta/utils": "workspace:*",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@noble/secp256k1": "^2.3.0",
    "@paulmillr/trusted-setups": "^0.3.0",
    "micro-eth-signer": "^0.18.1"
  },
  "peerDependencies": {
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@ethernauta/testing": "workspace:*",
    "tsdown": "^0.13.3",
    "valibot": "1.1.0"
  }
}
