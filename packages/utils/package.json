{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ethernauta/utils",
  "version": "0.0.48",
  "description": "Pure dependency-free helpers for Ethernauta — hex, bytes, BigInt, type guards.",
  "keywords": [
    "ethereum",
    "utils",
    "hex",
    "bytes",
    "bigint"
  ],
  "homepage": "https://ethernauta-docs.pages.dev/",
  "bugs": {
    "url": "https://github.com/niconiahi/ethernauta/issues"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/niconiahi/ethernauta"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest",
    "test:integration": "echo no integration tests",
    "test:cli": "bun src/compiler/cli.ts --abi src/erc/165/IERC165.abi.json --out src/erc/165"
  },
  "peerDependencies": {
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "bun": "^1.2.20",
    "tsdown": "^0.13.3",
    "@types/node": "^24.3.0"
  }
}
