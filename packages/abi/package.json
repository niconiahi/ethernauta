{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ethernauta/abi",
  "version": "0.0.47",
  "description": "ABI encode/decode codecs for Ethernauta — function signatures, event topics, parameter encoding/decoding.",
  "keywords": [
    "ethereum",
    "abi",
    "encode",
    "decode",
    "evm",
    "valibot"
  ],
  "homepage": "https://ethernauta-docs.pages.dev/",
  "bugs": {
    "url": "https://github.com/niconiahi/ethernauta/issues"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/niconiahi/ethernauta"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./generator": {
      "types": "./dist/generator/generator.d.ts",
      "import": "./dist/generator/generator.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest",
    "test:integration": "echo no integration tests",
    "test:cli": "bun src/compiler/cli.ts --abi src/erc/165/IERC165.abi.json --out src/erc/165"
  },
  "peerDependencies": {
    "valibot": "^1.1.0"
  },
  "dependencies": {
    "@ethernauta/core": "workspace:*",
    "@ethernauta/utils": "workspace:*",
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "bun": "^1.2.20",
    "tsdown": "^0.13.3"
  }
}
