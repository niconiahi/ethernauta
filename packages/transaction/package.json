{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ethernauta/transaction",
  "version": "0.0.47",
  "description": "Transaction lifecycle tracker for Ethernauta — pending → mined / reverted via receipt polling.",
  "keywords": [
    "ethereum",
    "transaction",
    "tracker",
    "lifecycle",
    "receipt"
  ],
  "homepage": "https://ethernauta-docs.pages.dev/",
  "bugs": {
    "url": "https://github.com/niconiahi/ethernauta/issues"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/niconiahi/ethernauta"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest",
    "test:integration": "echo no integration tests"
  },
  "peerDependencies": {
    "valibot": "^1.1.0"
  },
  "dependencies": {
    "@ethernauta/core": "workspace:*",
    "@ethernauta/eth": "workspace:*",
    "@ethernauta/transport": "workspace:*",
    "@ethernauta/utils": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.13.3"
  }
}
