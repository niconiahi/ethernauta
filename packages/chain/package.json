{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ethernauta/chain",
  "version": "0.0.47",
  "description": "500+ EIP-155 chain definitions for Ethernauta, indexed by chain_id.",
  "keywords": [
    "ethereum",
    "chain",
    "eip-155",
    "evm",
    "mainnet",
    "testnet"
  ],
  "homepage": "https://ethernauta-docs.pages.dev/",
  "bugs": {
    "url": "https://github.com/niconiahi/ethernauta/issues"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/niconiahi/ethernauta"
  },
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./*": {
      "types": "./dist/chain/eip155/*.d.mts",
      "import": "./dist/chain/eip155/*.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest",
    "test:integration": "echo no integration tests",
    "indexer": "bun src/indexer.ts && pnpm run format"
  },
  "peerDependencies": {
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript/native-preview": "7.0.0-dev.20260519.1",
    "simple-git": "^3.36.0",
    "tsdown": "^0.22.0"
  }
}
