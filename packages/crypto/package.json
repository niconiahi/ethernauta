{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ethernauta/crypto",
  "version": "0.0.47",
  "description": "Cross-spec signature + SIWE verification + HD key derivation for Ethernauta.",
  "keywords": [
    "ethereum",
    "crypto",
    "siwe",
    "hd-wallet",
    "bip39",
    "signature"
  ],
  "homepage": "https://ethernauta-docs.pages.dev/",
  "bugs": {
    "url": "https://github.com/niconiahi/ethernauta/issues"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/niconiahi/ethernauta"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest",
    "test:integration": "echo no integration tests"
  },
  "peerDependencies": {
    "valibot": "^1.1.0"
  },
  "dependencies": {
    "@ethernauta/core": "workspace:*",
    "@ethernauta/eip": "workspace:*",
    "@ethernauta/eth": "workspace:*",
    "@ethernauta/transport": "workspace:*",
    "@ethernauta/utils": "workspace:*",
    "@noble/hashes": "^1.8.0",
    "@noble/secp256k1": "^2.3.0",
    "@scure/bip32": "1.7.0",
    "@scure/bip39": "1.6.0"
  },
  "devDependencies": {
    "@ethernauta/testing": "workspace:*",
    "tsdown": "^0.13.3",
    "@types/node": "^24.3.0"
  }
}
