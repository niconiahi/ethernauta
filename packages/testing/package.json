{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ethernauta/testing",
  "version": "0.0.47",
  "description": "Vitest plugin + anvil spawner for Ethernauta-based dapp tests.",
  "keywords": [
    "ethereum",
    "testing",
    "vitest",
    "anvil",
    "foundry"
  ],
  "homepage": "https://ethernauta-docs.pages.dev/",
  "bugs": {
    "url": "https://github.com/niconiahi/ethernauta/issues"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/niconiahi/ethernauta"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest",
    "test:integration": "vitest --config ./integration/vitest.config.mjs"
  },
  "peerDependencies": {
    "valibot": "^1.1.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@ethernauta/core": "workspace:*",
    "@ethernauta/crypto": "workspace:*",
    "@ethernauta/eip": "workspace:*",
    "@ethernauta/transport": "workspace:*",
    "@ethernauta/utils": "workspace:*",
    "devalue": "^5.8.1"
  },
  "devDependencies": {
    "@ethernauta/eth": "workspace:*",
    "@ethernauta/testing": "workspace:*",
    "tsdown": "^0.13.3",
    "valibot": "1.1.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
