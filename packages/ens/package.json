{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ethernauta/ens",
  "version": "0.0.48",
  "description": "ENS primitives for Ethernauta — ENSIP normalize + resolver helpers.",
  "keywords": [
    "ethereum",
    "ens",
    "ensip",
    "namehash",
    "resolver"
  ],
  "homepage": "https://ethernauta-docs.pages.dev/",
  "bugs": {
    "url": "https://github.com/niconiahi/ethernauta/issues"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/niconiahi/ethernauta"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest",
    "test:integration": "echo no integration tests"
  },
  "peerDependencies": {
    "valibot": "^1.1.0"
  },
  "dependencies": {
    "@adraffy/ens-normalize": "^1.11.1",
    "@ethernauta/core": "workspace:*",
    "@ethernauta/eip": "workspace:*",
    "@ethernauta/erc": "workspace:*",
    "@ethernauta/transport": "workspace:*",
    "@ethernauta/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "bun": "^1.2.20",
    "tsdown": "^0.13.3"
  }
}
