{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ethernauta",
  "compatibility_date": "2025-04-04",
  "main": "./workers/app.ts",
  // TODO: make the application work without nodejs_compact
  // for some reason @noble/hashes conflicts with its NodeJS
  // compatibility
  // this is mentioned in the library itself here
  // https://www.npmjs.com/package/@noble/hashes?activeTab=code
  // in the file "utils.js", used by "sha256.js"
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare",
    // SIWE session-cookie HMAC key. Override in production
    // with `wrangler secret put SESSION_SECRET`. The dev
    // value below is intentionally non-secret — rotating
    // it just signs everyone out.
    "SESSION_SECRET": "dev-only-siwe-session-secret-change-me-in-prod"
  }
}
