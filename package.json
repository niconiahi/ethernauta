{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "ethernauta",
  "type": "module",
  "scripts": {
    "dev": "pnpm --recursive --parallel --filter @ethernauta/wallet --filter @ethernauta/playground --filter @ethernauta/docs run dev",
    "test:unit": "pnpm --recursive run test:unit",
    "test:integration": "pnpm --recursive run test:integration",
    "build": "pnpm --filter @ethernauta/cli run build && pnpm --recursive --filter '!@ethernauta/cli' --filter '!@ethernauta/wallet' --filter '!@ethernauta/playground' --filter '!@ethernauta/docs' run build",
    "build:wallet": "pnpm --filter @ethernauta/wallet run build",
    "lint": "pnpm --recursive --parallel run lint",
    "lint:fix": "pnpm --recursive --parallel run lint:fix",
    "lint:ratchet": "bash scripts/no-escape-hatches.sh",
    "format": "pnpm --recursive run format",
    "typecheck": "pnpm --recursive --parallel run typecheck",
    "publish": "pnpm --filter '!@ethernauta/wallet' --filter '!@ethernauta/playground' --filter '!@ethernauta/docs' publish",
    "publish:dry": "pnpm --filter '!@ethernauta/wallet' --filter '!@ethernauta/playground' --filter '!@ethernauta/docs' publish --dry-run",
    "deploy": "pnpm --filter @ethernauta/docs run deploy && pnpm --filter @ethernauta/playground run deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.1",
    "@edge-runtime/vm": "^5.0.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@total-typescript/tsconfig": "1.0.4",
    "tsdown": "^0.13.3",
    "typescript": "5.8.3",
    "vite": "7.0.5",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "^3.2.4"
  }
}
